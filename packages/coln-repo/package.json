  "devDependencies": {
    "@automerge/automerge-subduction": "0.16.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "ws": "^8.18.0"
  }
}
