{
  "name": "coln-sync-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "SUBDUCTION_SERVICE_NAME=127.0.0.1:3030 node server.mjs & relay_pid=$!; trap 'kill $relay_pid 2>/dev/null || true' EXIT INT TERM; VITE_SUBDUCTION_ENDPOINT=ws://127.0.0.1:3030 vite --host 0.0.0.0",
    "cli": "node cli-demo.ts",
    "server": "node server.mjs",
    "compile": "bash ./compile.sh",
    "build": "pnpm run compile && tsc --noEmit && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@automerge/automerge-repo": "github:automerge/automerge-repo#doctypes&path:packages/automerge-repo",
    "@automerge/automerge-subduction": "0.16.1",
    "@coln-project/coln-js-runtime": "link:../../packages/coln-js-runtime",
    "@coln-project/repo": "link:../../packages/coln-repo",
    "@coln-project/runtime": "link:../../packages/coln-js-runtime",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-wasm": "^3.6.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
